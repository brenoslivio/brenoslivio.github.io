{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build full academic CV",
      "type": "process",
      "command": "bash",
      "args": [
        "capybara/scripts/build.sh",
        "full"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "Build abbreviated academic CV",
      "type": "process",
      "command": "bash",
      "args": [
        "capybara/scripts/build.sh",
        "short"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "Build both academic CVs",
      "type": "process",
      "command": "bash",
      "args": [
        "capybara/scripts/build.sh",
        "both"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Refresh CV website links",
      "type": "process",
      "command": "bash",
      "args": ["capybara/scripts/build.sh", "links"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
