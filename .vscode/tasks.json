{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build CV PDF",
      "type": "process",
      "command": "typst",
      "args": [
        "compile",
        "--ignore-system-fonts",
        "capybara/cv.typ",
        "capybara/cv.pdf"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    }
  ]
}
