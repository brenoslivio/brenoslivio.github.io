{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Preview full academic CV",
      "type": "process",
      "command": "typst",
      "args": [
        "compile",
        "--root",
        "capybara",
        "--ignore-system-fonts",
        "capybara/src/cv.typ",
        "capybara/cv.pdf"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "Preview abbreviated academic CV",
      "type": "process",
      "command": "typst",
      "args": [
        "compile",
        "--root",
        "capybara",
        "--ignore-system-fonts",
        "capybara/src/cv-short.typ",
        "capybara/cv-short.pdf"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "Preview both academic CVs",
      "dependsOn": [
        "Preview full academic CV",
        "Preview abbreviated academic CV"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
